{
  "name": "discord-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Private BetterDiscord plugin workspace.",
  "scripts": {
    "build": "node scripts/build-selected.js all",
    "build:statustimer": "node scripts/build-selected.js StatusTimer",
    "build:commandcenter": "node scripts/build-selected.js CommandCenter",
    "test": "npm --prefix plugins/StatusTimer test && npm --prefix plugins/CommandCenter test",
    "sync:releases": "cp plugins/StatusTimer/dist/StatusTimer.plugin.js releases/StatusTimer.plugin.js && cp plugins/CommandCenter/dist/CommandCenter.plugin.js releases/CommandCenter.plugin.js"
  },
